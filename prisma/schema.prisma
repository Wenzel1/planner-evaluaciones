generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================
enum EstadoPlanificacion {
  BORRADOR
  REVISION
  APROBADO
  PUBLICADO
}

enum TipoExamen {
  TEORICO
  PRACTICO
  MIXTO
  PROYECTO
  ORAL
}

enum TipoPregunta {
  MULTIPLE_CHOICE
  DESARROLLO
  CODIGO
  CASO_PRACTICO
}

enum NivelBloom {
  RECORDAR
  COMPRENDER
  APLICAR
  ANALIZAR
  EVALUAR
  CREAR
}

enum EstadoEstudiante {
  ACTIVO
  INACTIVO
}

enum TipoComentario {
  SUGERENCIA
  ALERTA
  INFO
  EXITO
}

enum RolMensaje {
  AGENT
  USER
}

enum RolUsuario {
  SUPERADMIN
  ADMIN
  USUARIO
}

// ============================================
// MODELOS
// ============================================
model Usuario {
  id           String     @id @default(cuid())
  nombre       String
  email        String     @unique
  passwordHash String
  rol          RolUsuario @default(USUARIO)
  activo       Boolean    @default(true)
  pendiente    Boolean    @default(false) // true = se registró desde el login y espera aprobación de un administrador
  telefono     String?                    // para que un administrador pueda contactar a la persona (ej. entregar una clave temporal)
  cedula       String?    @unique         // documento de identidad (solo dígitos); lo ven únicamente la persona, los admins y el superadmin
  debeCambiarPassword Boolean @default(false) // true = entró con una clave temporal y debe elegir una nueva antes de usar el sistema
  sesionesDesde DateTime?                 // las sesiones iniciadas antes de esta fecha dejan de valer (se usa al restablecer claves)
  consentimientoEn DateTime?              // cuándo aceptó el tratamiento de sus datos personales
  // Verificación del teléfono por WhatsApp al registrarse (el código se guarda cifrado, nunca en texto plano)
  telefonoVerificado Boolean  @default(false)
  codigoHash         String?
  codigoExpira       DateTime?
  codigoIntentos     Int       @default(0)
  codigoEnviadoEn    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  materias       Materia[]
  estudiantes    Estudiante[]
  conversaciones Conversacion[]
  recuperaciones SolicitudRecuperacion[]
}

model Materia {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  codigo      String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  planificaciones Planificacion[]

  // Dueño (profesor que la creó). Si se elimina la cuenta, los datos quedan sin dueño (no se borran).
  usuarioId   String?
  usuario     Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  observaciones Observacion[]
  opiniones     OpinionPlan[]
  @@index([usuarioId])
}

model Planificacion {
  id              String              @id @default(cuid())
  version         Int                 @default(1)
  estado          EstadoPlanificacion @default(BORRADOR)
  fechaExamen     DateTime
  tipoExamen      TipoExamen          @default(MIXTO)
  duracionMinutos Int
  materiaId       String
  materia         Materia             @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  evaluaciones    Evaluacion[]
  rubrica         CriterioRubrica[]
  comentarios     ComentarioAgente[]
  conversaciones  Conversacion[]
}

model Evaluacion {
  id                    String          @id @default(cuid())
  nombre                String
  tipoPregunta          TipoPregunta    @default(MULTIPLE_CHOICE)
  peso                  Int?
  cantidadPreguntas     Int             @default(0)
  contenidosEvaluados   String[]
  nivelBloom            NivelBloom      @default(APLICAR)
  tiempoEstimadoMinutos Int?
  tipoActividad         String?
  descripcion           String?
  cantidadGrupos        Int?
  personasPorGrupo      Int?
  orden                 Int?
  enfoque               String?
  fecha                 DateTime?
  planificacionId       String
  planificacion         Planificacion   @relation(fields: [planificacionId], references: [id], onDelete: Cascade)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  calificaciones        Calificacion[]
  grupoSeccion String @default("A") // sección de estudiantes (A, B, C, D...) a la que pertenece

  // Estado de realización: PROGRAMADA | REALIZADA | REPROGRAMADA | CANCELADA
  // ("Por confirmar" no se guarda: es una PROGRAMADA cuya fecha ya pasó)
  estado        String    @default("PROGRAMADA")
  estadoEn      DateTime?
  recordatorios RecordatorioEnviado[]

  // Rúbrica propia de esta evaluación: { criterios: [{ nombre, puntos, descripciones: [Excelente, Bueno, Regular, Deficiente] }] }
  rubrica       Json?

  // Portal del estudiante: recursos de estudio [{ titulo, url }] y apertura manual antes de tiempo
  recursos      Json?
  abiertaManual Boolean   @default(false)
  preparaciones PreparacionEvaluacion[]
}

model CriterioRubrica {
  id              String         @id @default(cuid())
  nombre          String
  peso            Int
  descripcion     String
  planificacionId String
  planificacion   Planificacion  @relation(fields: [planificacionId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  niveles         NivelDesempeno[]
}

model NivelDesempeno {
  id          String          @id @default(cuid())
  nombre      String
  puntaje     Int
  descripcion String
  criterioId  String
  criterio    CriterioRubrica @relation(fields: [criterioId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Estudiante {
  id        String           @id @default(cuid())
  nombre    String
  email     String
  telefono  String?
  grupo     String           @default("A")
  estado    EstadoEstudiante @default(ACTIVO)
  promedio  Float            @default(0)
  asistencia Float           @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  calificaciones Calificacion[]

  // Enlace secreto de su página personal (/e/<token>). Se crea la primera vez que hace falta.
  enlaceToken String? @unique
  opiniones   OpinionPlan[]
  preparaciones PreparacionEvaluacion[]
  // Visitas a su página personal (no cuentan las del profesor)
  portalVisitas        Int       @default(0)
  portalPrimeraVisita  DateTime?
  portalUltimaVisita   DateTime?

  // Dueño (profesor). El mismo estudiante puede existir en la lista de varios profesores.
  usuarioId String?
  usuario   Usuario?         @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  @@unique([usuarioId, email])
  @@index([usuarioId])
}

model Calificacion {
  id            String     @id @default(cuid())
  puntaje       Float?   // nota sobre 20
  observaciones String?
  detalle       Json?    // nivel elegido en cada criterio de la rúbrica (0 Excelente … 3 Deficiente)
  estudianteId  String
  estudiante    Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  evaluacionId  String
  evaluacion    Evaluacion @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([estudianteId, evaluacionId])
}

model ComentarioAgente {
  id              String         @id @default(cuid())
  tipo            TipoComentario
  mensaje         String
  planificacionId String?
  planificacion   Planificacion? @relation(fields: [planificacionId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
}

model Conversacion {
  id              String         @id @default(cuid())
  titulo          String?
  planificacionId String?
  planificacion   Planificacion? @relation(fields: [planificacionId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  mensajes        Mensaje[]

  usuarioId       String?
  usuario         Usuario?       @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  @@index([usuarioId])
}

model Mensaje {
  id              String       @id @default(cuid())
  rol             RolMensaje
  contenido       String       @db.Text
  completo        Boolean      @default(false)
  conversacionId  String
  conversacion    Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
}

// Registro de actividad (auditoría). Guarda una copia del nombre/rol de quien actuó,
// así el historial se conserva aunque la cuenta se elimine.
model Actividad {
  id            String   @id @default(cuid())
  usuarioId     String?
  usuarioNombre String
  usuarioRol    String?
  accion        String
  entidad       String
  detalle       String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([accion])
}

// Observaciones que un ADMIN / SUPERADMIN deja sobre el trabajo de un profesor.
// Se anclan a la materia (no a la evaluación) porque las evaluaciones se vuelven a guardar con cada cambio.
model Observacion {
  id               String   @id @default(cuid())
  materiaId        String
  materia          Materia  @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  evaluacionNombre String?
  autorId          String?
  autorNombre      String
  autorRol         String
  mensaje          String
  leida            Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([materiaId])
  @@index([createdAt])
}

// Papelera: lo que se elimina se guarda aquí 30 días para poder restaurarlo.
model PapeleraItem {
  id                 String   @id @default(cuid())
  usuarioId          String   // dueño: la persona que puede restaurarlo
  tipo               String   // 'EVALUACION' | 'ESTUDIANTE'
  nombre             String
  contexto           String?
  datos              Json
  eliminadoPorId     String?
  eliminadoPorNombre String
  createdAt          DateTime @default(now()) // fecha de eliminación

  @@index([usuarioId, createdAt])
  @@index([createdAt])
}

// Solicitudes de "olvidé mi contraseña": las atiende el SUPERADMIN (restablece la clave y se la hace llegar a la persona).
model SolicitudRecuperacion {
  id          String    @id @default(cuid())
  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  estado      String    @default("PENDIENTE") // PENDIENTE | ATENDIDA
  createdAt   DateTime  @default(now())
  atendidaPor String?
  atendidaEn  DateTime?

  @@index([estado, createdAt])
}

// Configuración del sistema (chat y modelo de lenguaje, límites del planificador, acceso). Un solo registro: id = 'principal'.
model ConfiguracionSistema {
  id             String   @id
  datos          Json
  actualizadoPor String?
  updatedAt      DateTime @updatedAt
}

// Recordatorios por WhatsApp ya enviados (3 días, 1 día y 2 horas antes). Si la evaluación cambia de fecha,
// la fecha nueva cuenta como distinta y los recordatorios se vuelven a enviar.
model RecordatorioEnviado {
  id              String     @id @default(cuid())
  evaluacionId    String
  evaluacion      Evaluacion @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)
  tipo            String     // '3D' | '1D' | '2H'
  fechaEvaluacion DateTime
  enviados        Int        @default(0)
  createdAt       DateTime   @default(now())

  @@unique([evaluacionId, tipo, fechaEvaluacion])
}

// Copia del Plan de Acción que se compartió por WhatsApp. El PDF se genera una vez y se guarda aquí;
// los estudiantes lo reciben mediante un enlace con un token imposible de adivinar.
model PlanCompartido {
  id        String   @id @default(cuid())
  token     String   @unique
  usuarioId String
  seccion   String
  materia   String
  datos     Json
  pdf       Bytes?
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

// Cada mensaje de WhatsApp enviado a un estudiante (plan de acción o recordatorio) y su resultado.
model EnvioWhatsApp {
  id           String    @id
  loteId       String
  usuarioId    String    // profesor dueño
  tipo         String    // 'PLAN' | 'RECORDATORIO' | 'NOTA'
  estudianteId String?
  nombre       String
  telefono     String
  estado       String    @default("PENDIENTE") // PENDIENTE | ENVIADO | FALLIDO
  error        String?
  createdAt    DateTime  @default(now())
  enviadoEn    DateTime?

  @@index([loteId])
  @@index([usuarioId, createdAt])
}

// Opinión de un estudiante sobre el plan de evaluación de una materia (desde su página personal). Una por estudiante y materia.
model OpinionPlan {
  id           String     @id @default(cuid())
  estudianteId String
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  materiaId    String
  materia      Materia    @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  deAcuerdo    Boolean
  comentario   String?
  leida        Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([estudianteId, materiaId])
  @@index([materiaId])
}

// "Ya me preparé": el estudiante lo marca en su página antes de la evaluación
model PreparacionEvaluacion {
  id           String     @id @default(cuid())
  estudianteId String
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  evaluacionId String
  evaluacion   Evaluacion @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([estudianteId, evaluacionId])
  @@index([evaluacionId])
}
